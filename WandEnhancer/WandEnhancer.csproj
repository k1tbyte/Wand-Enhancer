    </Target>

    <!-- Which commit a binary was built from. AssemblyVersion is pinned to the release tag, so
         every candidate for one version reports the same number, and everyone builds their own
         binary. Empty when there is no git to ask, which Constants reports as unofficial. -->
    <Target Name="StampBuild" BeforeTargets="CoreCompile">
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; describe --always --dirty --match=nothing 2&gt;nul"
              ConsoleToMSBuild="true" ContinueOnError="true"
              StandardOutputImportance="low" IgnoreStandardErrorWarningFormat="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="BuildStamp" />
            <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
        </Exec>

        <PropertyGroup>
            <BuildStamp Condition="'$(GitExitCode)' != '0'"></BuildStamp>
            <BuildStampFile>$(IntermediateOutputPath)BuildStamp.cs</BuildStampFile>
        </PropertyGroup>

        <WriteLinesToFile File="$(BuildStampFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                          Lines="namespace WandEnhancer { internal static class BuildStamp { public const string Value = &quot;$(BuildStamp)&quot;%3B } }" />

        <ItemGroup>
            <Compile Include="$(BuildStampFile)" />
        </ItemGroup>
    </Target>

    <Target Name="ILRepack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
            <ILRepackExe>..\packages\ILRepack.2.0.41\tools\ILRepack.exe</ILRepackExe>
            <MainAssembly>$(OutputPath)$(AssemblyName).exe</MainAssembly>
        </PropertyGroup>

        <ItemGroup>
        <AssemblyList Include="$(OutputPath)*.dll" />
        </ItemGroup>

        <PropertyGroup>
            <DllList>@(AssemblyList->'%(FullPath)', ' ')</DllList>
        </PropertyGroup>

        <Delete Files="$(OutputPath)$(AssemblyName).pdb" ContinueOnError="true" />
        <Exec Command="&quot;$(ILRepackExe)&quot; /allowMultiple /copyattrs /out:&quot;$(OutputPath)$(AssemblyName).exe&quot; &quot;$(MainAssembly)&quot; $(DllList)" />
        <Delete Files="@(AssemblyList)" ContinueOnError="true" />
    </Target>
